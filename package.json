{
  "name": "orca",
  "version": "1.0.0",
  "description": "Orca — a local-first game library, launcher, and playtime tracker for Windows.",
  "main": "./out/main/index.js",
  "author": "Orca",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "build": "pnpm typecheck && electron-vite build",
    "build:win": "pnpm build && electron-builder --win",
    "build:dir": "pnpm build && electron-builder --win --dir",
    "icon": "node scripts/make-icon.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:pkg": "node scripts/smoke.mjs release/win-unpacked/Orca.exe"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "clsx": "^2.1.1",
    "koffi": "^3.3.6",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
